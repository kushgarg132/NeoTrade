# Run from the repo root (or /app in the image):
#   lint-imports --config backend/.importlinter
# Permissive on purpose: only directions that are clearly wrong. Lazy (in-function)
# imports count too; only direct imports are checked (allow_indirect_imports). Existing violations are listed under ignore_imports as known
# debt (docs/wiki/platform.md "Import rules"); remove a line when the import is fixed.
[importlinter]
root_package = backend
include_external_packages = False

[importlinter:contract:domain-not-routers]
name = Domain modules do not import HTTP routers
type = forbidden
source_modules =
    backend.ai
    backend.autopilot
    backend.brokers
    backend.builder
    backend.chat
    backend.data
    backend.datalayer
    backend.engine
    backend.factor
    backend.forecast
    backend.forward
    backend.guardrails
    backend.instruments
    backend.journal
    backend.learning
    backend.mine
    backend.options
    backend.plan
    backend.portfolio
    backend.research
    backend.risk
    backend.scoring
    backend.strategies
    backend.suggestions
allow_indirect_imports = True
forbidden_modules =
    backend.routers
ignore_imports =
    backend.ai.analyst -> backend.routers.news
    backend.ai.facts.user -> backend.routers.portfolio
    backend.chat.actions -> backend.routers.settings
    backend.chat.actions -> backend.routers.suggestions
    backend.chat.actions -> backend.routers.trading
    backend.chat.tools -> backend.routers.news
    backend.chat.tools -> backend.routers.portfolio
    backend.datalayer.news -> backend.routers.news
    backend.engine.autorun -> backend.routers.trading
    backend.guardrails.telegram_bot -> backend.routers.settings
    backend.mine.stock -> backend.routers.portfolio
    backend.portfolio.health -> backend.routers.news
    backend.research.index_move -> backend.routers.market_data
    backend.research.index_move -> backend.routers.news

[importlinter:contract:own-account-not-autopilot]
name = Mine and journal never reach the AI account's autopilot
type = forbidden
source_modules =
    backend.mine
    backend.journal
allow_indirect_imports = True
forbidden_modules =
    backend.autopilot

[importlinter:contract:nothing-imports-research-tools]
name = Nothing imports the forecast research tools (run by hand only)
type = forbidden
source_modules =
    backend.ai
    backend.autopilot
    backend.engine
    backend.forecast.picks
    backend.forecast.setups
    backend.forecast.study
    backend.mine
    backend.plan
    backend.portfolio
    backend.routers
    backend.scheduler
    backend.server
    backend.jobs
    backend.system
allow_indirect_imports = True
forbidden_modules =
    backend.forecast.research

[importlinter:contract:lab-is-a-leaf]
name = The research lab does not import HTTP routers or the autopilot
type = forbidden
source_modules =
    backend.lab
allow_indirect_imports = True
forbidden_modules =
    backend.routers
    backend.autopilot

[importlinter:contract:ml-is-a-leaf]
name = The ML harness does not import routers, the autopilot or the engine
type = forbidden
source_modules =
    backend.ml
allow_indirect_imports = True
forbidden_modules =
    backend.routers
    backend.autopilot
    backend.engine

[importlinter:contract:nothing-imports-ml]
name = The app does not import the ML harness (run by hand only)
type = forbidden
source_modules =
    backend.ai
    backend.autopilot
    backend.engine
    backend.forecast
    backend.lab
    backend.mine
    backend.plan
    backend.portfolio
    backend.routers
    backend.scheduler
    backend.server
    backend.jobs
    backend.system
allow_indirect_imports = True
forbidden_modules =
    backend.ml

[importlinter:contract:rl-is-a-leaf]
name = The RL sandbox does not import routers, the autopilot or the engine
type = forbidden
source_modules =
    backend.rl
allow_indirect_imports = True
forbidden_modules =
    backend.routers
    backend.autopilot
    backend.engine

[importlinter:contract:nothing-imports-rl]
name = The app does not import the RL sandbox (run by hand only)
type = forbidden
source_modules =
    backend.ai
    backend.auth
    backend.autopilot
    backend.brokers
    backend.builder
    backend.chat
    backend.core
    backend.data
    backend.datalayer
    backend.engine
    backend.factor
    backend.forecast
    backend.forward
    backend.guardrails
    backend.instruments
    backend.jobs
    backend.journal
    backend.lab
    backend.learning
    backend.llm
    backend.mine
    backend.ml
    backend.options
    backend.plan
    backend.portfolio
    backend.profile
    backend.research
    backend.risk
    backend.routers
    backend.scheduler
    backend.scoring
    backend.server
    backend.strategies
    backend.suggestions
    backend.system
    backend.ws
allow_indirect_imports = True
forbidden_modules =
    backend.rl
